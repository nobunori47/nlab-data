{
  "name": "nlab-data",
  "version": "1.1.0-rc.1",
  "private": true,
  "description": "N-Lab shared canonical work data",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "verify": "node --import tsx scripts/verify-sync.ts",
    "sync": "node scripts/sync.js",
    "sync:dry": "node scripts/sync.js --dry-run",
    "test": "node --import tsx --test scripts/catalog.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "20.19.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
